# Dockerfile for FastAPI service
# Bonus Feature: Docker (+1 mark)

FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install only serving dependencies. Training, MLflow, Streamlit, explainability,
# and development packages do not belong in the API runtime image.
COPY docker/requirements.api.txt ./requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY config/ ./config/
COPY src/ ./src/
COPY models/ ./models/
COPY artifacts/ ./artifacts/
COPY data/raw/telco_customer_churn.csv ./data/raw/telco_customer_churn.csv

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Run API server
CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
